# Salin file ini ke .env dan isi nilai-nilainya
# Jangan commit .env ke git

# Database (Postgres service di compose — host = nama service `postgres`)
POSTGRES_USER=purrtein
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=purrtein
# DATABASE_URL dipakai backend; host & kredensial harus match POSTGRES_* di atas
DATABASE_URL=postgresql://purrtein:ganti_dengan_password_kuat@postgres:5432/purrtein

# Redis (queue BullMQ + cache) — host = nama service `redis`, tidak di-expose publik
REDIS_URL=redis://redis:6379

# MQTT
EMQX_NODE_COOKIE=ganti_dengan_random_string

# MediaMTX
MEDIAMTX_PASS=ganti_dengan_password_kuat

# MJPEG ingest (ESP32 stream push -> ffmpeg -> mediamtx)
# Harus sama persis dengan STREAM_INGEST_TOKEN di firmware include/secrets.h
INGEST_TOKEN=ganti_dengan_random_string

# Backend
NODE_ENV=production
# JWT — WAJIB min 32 char, random & beda. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=ganti_dengan_random_min_32_char
JWT_REFRESH_SECRET=ganti_dengan_random_min_32_char
# Backend consume event device dari broker internal (plain, network `internal`).
# MQTT_USERNAME/PASSWORD harus diterima EMQX (lihat emqx/acl.conf).
MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_USERNAME=ganti_sesuai_emqx
MQTT_PASSWORD=ganti_sesuai_emqx
# Cookie & CORS untuk prod (HTTPS)
COOKIE_DOMAIN=purrduli.tech
COOKIE_SECURE=true
FRONTEND_URL=https://purrduli.tech
# MediaMTX API (internal) untuk stream worker
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_WHEP_BASE_URL=https://stream.purrduli.tech

# Domain
DOMAIN=purrduli.tech

# Public IP VPS — dipakai mediamtx untuk advertise ICE candidate yang reachable dari browser
# Cek: curl ifconfig.me (di VPS) atau lihat Hostinger panel
VPS_PUBLIC_IP=145.79.10.86
